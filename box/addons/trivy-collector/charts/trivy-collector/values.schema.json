{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "trivy-collector values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object"
    },
    "crds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "install": {
          "type": "boolean"
        },
        "keep": {
          "type": "boolean"
        },
        "annotations": {
          "$ref": "#/definitions/stringMap"
        },
        "additionalLabels": {
          "$ref": "#/definitions/stringMap"
        }
      }
    },
    "nameOverride": {
      "type": [
        "string",
        "null"
      ]
    },
    "fullnameOverride": {
      "type": [
        "string",
        "null"
      ]
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 0
    },
    "revisionHistoryLimit": {
      "type": "integer",
      "minimum": 0
    },
    "image": {
      "$ref": "#/definitions/image"
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "automount": {
          "type": "boolean"
        },
        "annotations": {
          "$ref": "#/definitions/stringMap"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "podAnnotations": {
      "$ref": "#/definitions/stringMap"
    },
    "podLabels": {
      "$ref": "#/definitions/stringMap"
    },
    "podSecurityContext": {
      "type": "object"
    },
    "securityContext": {
      "type": "object"
    },
    "clusterName": {
      "type": "string",
      "minLength": 1
    },
    "scraper": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "namespaces": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "watchLocal": {
          "type": "boolean"
        },
        "collect": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "vulnerabilityReports": {
              "type": "boolean"
            },
            "sbomReports": {
              "type": "boolean"
            }
          }
        },
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mountPath": {
              "type": "string",
              "minLength": 1
            },
            "sizeLimit": {
              "type": [
                "string",
                "integer"
              ]
            },
            "medium": {
              "type": "string"
            }
          }
        },
        "strategy": {
          "type": "object"
        },
        "readinessProbe": {
          "type": "object"
        },
        "resources": {
          "type": [
            "object",
            "null"
          ]
        },
        "resizePolicy": {
          "type": [
            "array",
            "null"
          ]
        },
        "nodeSelector": {
          "type": [
            "object",
            "null"
          ]
        },
        "tolerations": {
          "type": [
            "array",
            "null"
          ]
        },
        "affinity": {
          "type": [
            "object",
            "null"
          ]
        },
        "topologySpreadConstraints": {
          "type": [
            "array",
            "null"
          ]
        },
        "serviceMonitor": {
          "$ref": "#/definitions/serviceMonitor"
        }
      }
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicaCount": {
          "type": "integer",
          "minimum": 0
        },
        "podDisruptionBudget": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "minAvailable": {
              "type": [
                "integer",
                "string"
              ]
            },
            "maxUnavailable": {
              "type": [
                "integer",
                "string"
              ]
            }
          }
        },
        "port": {
          "$ref": "#/definitions/port"
        },
        "externalUrl": {
          "type": "string"
        },
        "resources": {
          "type": [
            "object",
            "null"
          ]
        },
        "resizePolicy": {
          "type": [
            "array",
            "null"
          ]
        },
        "nodeSelector": {
          "type": [
            "object",
            "null"
          ]
        },
        "tolerations": {
          "type": [
            "array",
            "null"
          ]
        },
        "affinity": {
          "type": [
            "object",
            "null"
          ]
        },
        "topologySpreadConstraints": {
          "type": [
            "array",
            "null"
          ]
        },
        "mcp": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "allowedHosts": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "stateless": {
              "type": "boolean"
            }
          }
        },
        "serviceMonitor": {
          "$ref": "#/definitions/serviceMonitor"
        },
        "gateway": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "name": {
              "type": "string"
            },
            "parentRefs": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name"
                ],
                "properties": {
                  "group": {
                    "type": "string"
                  },
                  "kind": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "namespace": {
                    "type": "string"
                  },
                  "sectionName": {
                    "type": "string"
                  }
                }
              }
            },
            "hostnames": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "rules": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "matches": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "path"
                      ],
                      "properties": {
                        "path": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "type",
                            "value"
                          ],
                          "properties": {
                            "type": {
                              "type": "string",
                              "enum": [
                                "Exact",
                                "PathPrefix",
                                "RegularExpression"
                              ]
                            },
                            "value": {
                              "type": "string"
                            }
                          }
                        }
                      }
                    }
                  },
                  "filters": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    }
                  },
                  "backendRefs": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "group": {
                          "type": "string"
                        },
                        "kind": {
                          "type": "string"
                        },
                        "name": {
                          "type": "string"
                        },
                        "port": {
                          "$ref": "#/definitions/port"
                        },
                        "weight": {
                          "type": "integer",
                          "minimum": 0
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "none",
                "keycloak"
              ]
            },
            "rbac": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "policy": {
                  "type": "string"
                },
                "defaultPolicy": {
                  "type": "string"
                }
              }
            },
            "sso": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "issuer": {
                  "type": "string"
                },
                "clientId": {
                  "$ref": "#/definitions/secretRef"
                },
                "clientSecret": {
                  "$ref": "#/definitions/secretRef"
                },
                "redirectUrl": {
                  "type": "string"
                },
                "scopes": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "$ref": "#/definitions/serviceType"
        },
        "port": {
          "$ref": "#/definitions/port"
        },
        "annotations": {
          "$ref": "#/definitions/stringMap"
        }
      }
    },
    "internal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "port": {
          "$ref": "#/definitions/port"
        },
        "token": {
          "type": "string"
        },
        "existingSecret": {
          "type": "string"
        },
        "secretKey": {
          "type": "string",
          "minLength": 1
        },
        "networkPolicy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "extraFrom": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "port": {
          "$ref": "#/definitions/port"
        }
      }
    },
    "logging": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "format": {
          "type": "string",
          "enum": [
            "json",
            "pretty"
          ]
        },
        "level": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "livenessProbe": {
      "type": "object"
    },
    "readinessProbe": {
      "type": "object"
    },
    "dnsPolicy": {
      "$ref": "#/definitions/dnsPolicy"
    },
    "dnsConfig": {
      "type": [
        "object",
        "null"
      ]
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "exportState": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "existingClaim": {
              "type": "string"
            },
            "dbPath": {
              "type": "string",
              "minLength": 1
            },
            "dryRun": {
              "type": "boolean"
            },
            "backoffLimit": {
              "type": "integer",
              "minimum": 0
            },
            "ttlSecondsAfterFinished": {
              "type": "integer",
              "minimum": 0
            },
            "nodeSelector": {
              "type": [
                "object",
                "null"
              ]
            },
            "tolerations": {
              "type": [
                "array",
                "null"
              ]
            },
            "affinity": {
              "type": [
                "object",
                "null"
              ]
            },
            "resources": {
              "type": [
                "object",
                "null"
              ]
            }
          }
        }
      }
    },
    "extraObjects": {
      "$ref": "#/definitions/extraObjects"
    }
  },
  "definitions": {
    "stringMap": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "registry": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "serviceType": {
      "type": "string",
      "enum": [
        "ClusterIP",
        "NodePort",
        "LoadBalancer"
      ]
    },
    "dnsPolicy": {
      "type": "string",
      "enum": [
        "",
        "ClusterFirst",
        "ClusterFirstWithHostNet",
        "Default",
        "None"
      ]
    },
    "extraObjects": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "serviceMonitor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "interval": {
          "type": "string"
        },
        "scrapeTimeout": {
          "type": "string"
        },
        "additionalLabels": {
          "$ref": "#/definitions/stringMap"
        },
        "annotations": {
          "$ref": "#/definitions/stringMap"
        }
      }
    },
    "secretRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "key": {
          "type": "string"
        }
      }
    }
  }
}
