{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "volume-autoscaler values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object"
    },
    "nameOverride": {
      "type": ["string", "null"]
    },
    "fullnameOverride": {
      "type": ["string", "null"]
    },
    "image": {
      "$ref": "#/definitions/image"
    },
    "imagePullSecrets": {
      "$ref": "#/definitions/nullableObjectList"
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 0
    },
    "revisionHistoryLimit": {
      "type": "integer",
      "minimum": 0
    },
    "strategy": {
      "type": "object"
    },
    "pdb": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "maxUnavailable": {
          "type": ["integer", "string"],
          "minimum": 0
        },
        "unhealthyPodEvictionPolicy": {
          "type": ["string", "null"],
          "enum": ["", "IfHealthyBudget", "AlwaysAllow", null]
        }
      }
    },
    "controllers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["instance-volume-autoscaler", "persistent-volume-claim-autoscaler", "unused-volume-scan"]
      }
    },
    "crds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "install": {
          "type": "boolean"
        },
        "keep": {
          "type": "boolean"
        },
        "annotations": {
          "$ref": "#/definitions/nullableStringMap"
        },
        "additionalLabels": {
          "$ref": "#/definitions/nullableStringMap"
        }
      }
    },
    "instanceVolumeAutoscalers": {
      "type": ["array", "null"],
      "items": {
        "$ref": "#/definitions/autoscaler"
      }
    },
    "persistentVolumeClaimAutoscalers": {
      "type": ["array", "null"],
      "items": {
        "$ref": "#/definitions/claimAutoscaler"
      }
    },
    "config": {
      "$ref": "#/definitions/config"
    },
    "extraEnv": {
      "$ref": "#/definitions/nullableObjectList"
    },
    "extraEnvFrom": {
      "$ref": "#/definitions/nullableObjectList"
    },
    "ports": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "health": {
          "$ref": "#/definitions/port"
        },
        "metrics": {
          "$ref": "#/definitions/port"
        }
      }
    },
    "rbac": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": ["string", "null"]
        },
        "annotations": {
          "$ref": "#/definitions/nullableStringMap"
        },
        "automountServiceAccountToken": {
          "type": "boolean"
        },
        "imagePullSecrets": {
          "$ref": "#/definitions/nullableObjectList"
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "type": {
          "type": "string",
          "enum": ["ClusterIP", "NodePort", "LoadBalancer"]
        },
        "trafficDistribution": {
          "type": ["string", "null"]
        }
      }
    },
    "serviceMonitor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "interval": {
          "type": "string"
        },
        "scrapeTimeout": {
          "type": "string"
        },
        "labels": {
          "$ref": "#/definitions/nullableStringMap"
        }
      }
    },
    "resources": {
      "type": "object"
    },
    "resizePolicy": {
      "$ref": "#/definitions/nullableObjectList"
    },
    "podAnnotations": {
      "$ref": "#/definitions/nullableStringMap"
    },
    "podLabels": {
      "$ref": "#/definitions/nullableStringMap"
    },
    "podSecurityContext": {
      "type": "object"
    },
    "securityContext": {
      "type": "object"
    },
    "priorityClassName": {
      "type": ["string", "null"]
    },
    "nodeSelector": {
      "$ref": "#/definitions/nullableStringMap"
    },
    "tolerations": {
      "$ref": "#/definitions/nullableObjectList"
    },
    "affinity": {
      "type": ["object", "null"]
    },
    "topologySpreadConstraints": {
      "$ref": "#/definitions/nullableObjectList"
    },
    "dnsPolicy": {
      "type": ["string", "null"],
      "enum": ["", "ClusterFirst", "ClusterFirstWithHostNet", "Default", "None", null]
    },
    "dnsConfig": {
      "type": ["object", "null"]
    },
    "extraObjects": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "definitions": {
    "stringMap": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "nullableStringMap": {
      "type": ["object", "null"],
      "additionalProperties": {
        "type": "string"
      }
    },
    "nullableObjectList": {
      "type": ["array", "null"],
      "items": {
        "type": "object"
      }
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "goDuration": {
      "type": "string",
      "pattern": "^ *\\+?(0|([0-9]+(ns|us|µs|ms|s|m|h|d))+) *$"
    },
    "notifyOutcome": {
      "type": "string",
      "enum": ["all", "success", "failure"]
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "registry": {
          "type": "string"
        },
        "repository": {
          "type": "string"
        },
        "tag": {
          "type": ["string", "null"]
        },
        "digest": {
          "type": ["string", "null"],
          "pattern": "^(sha256:[a-f0-9]{64})?$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "region": {
          "type": "string"
        },
        "reconcileInterval": {
          "$ref": "#/definitions/goDuration"
        },
        "claimReconcileInterval": {
          "$ref": "#/definitions/goDuration"
        },
        "reconcileConcurrency": {
          "type": "integer",
          "minimum": 1
        },
        "ssmCommandTimeout": {
          "$ref": "#/definitions/goDuration"
        },
        "ssmPollInterval": {
          "$ref": "#/definitions/goDuration"
        },
        "volumeModifyTimeout": {
          "$ref": "#/definitions/goDuration"
        },
        "dryRun": {
          "type": "boolean"
        },
        "logLevel": {
          "type": "string"
        },
        "logFormat": {
          "type": "string"
        },
        "alertmanager": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "url": {
              "type": "string"
            },
            "timeout": {
              "$ref": "#/definitions/goDuration"
            },
            "labels": {
              "$ref": "#/definitions/stringMap"
            },
            "notifyOn": {
              "$ref": "#/definitions/notifyOutcome"
            },
            "dashboardUrl": {
              "type": "string"
            }
          }
        },
        "grafanaAnnotation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "url": {
              "type": "string"
            },
            "timeout": {
              "$ref": "#/definitions/goDuration"
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "annotateOn": {
              "$ref": "#/definitions/notifyOutcome"
            },
            "apiToken": {
              "type": "string"
            },
            "existingSecret": {
              "type": "string"
            },
            "existingSecretKey": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "url": {
              "type": "string"
            },
            "tenantId": {
              "type": "string"
            },
            "labelSelector": {
              "$ref": "#/definitions/nullableStringMap"
            }
          }
        },
        "throughputRecommendation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "metricNodeNameLabel": {
              "type": "string",
              "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
            },
            "lookbackWindow": {
              "type": "string",
              "pattern": "^([0-9]+(ms|s|m|h|d|w|y))+$"
            },
            "interval": {
              "$ref": "#/definitions/goDuration"
            },
            "applyOnResize": {
              "type": "boolean"
            }
          }
        },
        "orphanPvcCleanup": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "minUnusedAge": {
              "$ref": "#/definitions/goDuration"
            },
            "reasons": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "enum": ["no_consumer_pod", "statefulset_scaled_down", "unbound"]
              }
            },
            "includeNamespaces": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "excludeNamespaces": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "maxDeletionsPerPass": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "alertEnabled": {
              "type": "boolean"
            },
            "alertBefore": {
              "$ref": "#/definitions/goDuration"
            }
          }
        }
      }
    },
    "autoscaler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "spec"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
          "maxLength": 253
        },
        "labels": {
          "$ref": "#/definitions/nullableStringMap"
        },
        "annotations": {
          "$ref": "#/definitions/nullableStringMap"
        },
        "spec": {
          "type": "object",
          "required": ["scaleTargetRef", "maxCapacity"],
          "properties": {
            "scaleTargetRef": {
              "type": "object"
            },
            "maxCapacity": {
              "type": ["string", "integer"]
            },
            "metrics": {
              "type": "array"
            },
            "behavior": {
              "type": "object"
            },
            "alertEnabled": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      }
    },
    "claimAutoscaler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "spec"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
          "maxLength": 253
        },
        "namespace": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "maxLength": 63
        },
        "labels": {
          "$ref": "#/definitions/nullableStringMap"
        },
        "annotations": {
          "$ref": "#/definitions/nullableStringMap"
        },
        "spec": {
          "type": "object",
          "required": ["scaleTargetRef", "maxCapacity"],
          "properties": {
            "scaleTargetRef": {
              "type": "object"
            },
            "maxCapacity": {
              "type": ["string", "integer"]
            },
            "metrics": {
              "type": "array"
            },
            "behavior": {
              "type": "object"
            }
          },
          "additionalProperties": false
        }
      }
    }
  }
}
