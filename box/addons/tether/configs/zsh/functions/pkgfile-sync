zmodload -F zsh/datetime b:strftime p:EPOCHSECONDS

local state_dir=${XDG_STATE_HOME:-$HOME/.local/state}/pkgfile-sync
local stamp=$state_dir/last-run
local today
strftime -s today %F $EPOCHSECONDS

[[ -r $stamp && "$(<$stamp)" == $today ]] && return 0

local pm_dir=${${:-$HOME/.config/zsh/functions}:A:h:h}/package-managers
[[ -d $pm_dir/brew && -d $pm_dir/krew ]] || return 0

mkdir -p $state_dir
print -r -- $today > $stamp

{
  local tmp target

  if (( $+commands[brew] )); then
    target=$pm_dir/brew/Brewfile
    tmp=$(mktemp)
    if brew bundle dump --force --file=$tmp; then
      {
        print "#-------------------------------"
        print "# PACKAGE INSTALLATION SUMMARY"
        print "# Date: $today"
        print "#-------------------------------"
        local section
        for section in tap brew cask mas vscode; do
          print "# Installed $section count: $(grep -c "^$section " $tmp)"
        done
        print "#-------------------------------"
      } >> $tmp
      if [[ "$(grep -v '^#' $tmp)" != "$(grep -v '^#' $target 2>/dev/null)" ]]; then
        chmod 644 $tmp && mv -f $tmp $target
      fi
    fi
    rm -f $tmp
  fi

  if (( $+commands[kubectl] )) && kubectl krew version &>/dev/null; then
    target=$pm_dir/krew/krewfile
    tmp=$(mktemp)
    {
      print "#---------------------------------"
      print "# Backup completed on $today "
      print "# Krew version is $(kubectl krew version | awk '/GitTag/ {print $2}')   "
      print "#---------------------------------"
      kubectl krew list
    } > $tmp
    if [[ "$(grep -v '^#' $tmp)" != "$(grep -v '^#' $target 2>/dev/null)" ]]; then
      chmod 644 $tmp && mv -f $tmp $target
    fi
    rm -f $tmp
  fi
} &>/dev/null &!
