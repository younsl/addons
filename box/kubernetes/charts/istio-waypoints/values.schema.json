{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "istio-waypoints values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object"
    },
    "nameOverride": {
      "type": [
        "string",
        "null"
      ]
    },
    "fullnameOverride": {
      "type": [
        "string",
        "null"
      ]
    },
    "commonLabels": {
      "$ref": "#/definitions/stringMap"
    },
    "commonAnnotations": {
      "$ref": "#/definitions/stringMap"
    },
    "defaults": {
      "$ref": "#/definitions/waypoint"
    },
    "waypoints": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
      },
      "additionalProperties": {
        "$ref": "#/definitions/waypoint"
      }
    },
    "extraObjects": {
      "type": "array",
      "items": {
        "type": [
          "object",
          "string"
        ]
      }
    }
  },
  "definitions": {
    "stringMap": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "nullableObject": {
      "type": [
        "object",
        "null"
      ]
    },
    "waypoint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "name": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "maxLength": 63
        },
        "namespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63
        },
        "waypointFor": {
          "type": "string",
          "enum": [
            "service",
            "workload",
            "all",
            "none"
          ]
        },
        "revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "gatewayApiVersion": {
          "type": "string",
          "enum": [
            "gateway.networking.k8s.io/v1",
            "gateway.networking.k8s.io/v1beta1"
          ]
        },
        "gatewayClassName": {
          "type": "string",
          "minLength": 1
        },
        "listener": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "protocol": {
              "type": "string",
              "minLength": 1
            },
            "allowedRoutes": {
              "type": [
                "object",
                "null"
              ]
            }
          }
        },
        "labels": {
          "$ref": "#/definitions/stringMap"
        },
        "annotations": {
          "$ref": "#/definitions/stringMap"
        },
        "infrastructure": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "labels": {
              "$ref": "#/definitions/stringMap"
            },
            "annotations": {
              "$ref": "#/definitions/stringMap"
            }
          }
        },
        "container": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true,
          "properties": {
            "name": {
              "type": "string",
              "const": "istio-proxy"
            },
            "resources": {
              "type": [
                "object",
                "null"
              ]
            },
            "resizePolicy": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "resourceName",
                  "restartPolicy"
                ],
                "properties": {
                  "resourceName": {
                    "type": "string",
                    "enum": [
                      "cpu",
                      "memory"
                    ]
                  },
                  "restartPolicy": {
                    "type": "string",
                    "enum": [
                      "NotRequired",
                      "RestartContainer"
                    ]
                  }
                }
              }
            },
            "lifecycle": {
              "type": [
                "object",
                "null"
              ]
            },
            "env": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "object"
              }
            }
          }
        },
        "parameters": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "deployment": {
              "$ref": "#/definitions/nullableObject"
            },
            "service": {
              "$ref": "#/definitions/nullableObject"
            },
            "serviceAccount": {
              "$ref": "#/definitions/nullableObject"
            },
            "horizontalPodAutoscaler": {
              "$ref": "#/definitions/nullableObject"
            },
            "podDisruptionBudget": {
              "$ref": "#/definitions/nullableObject"
            }
          }
        },
        "telemetry": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "accessLogging": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "metrics": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "tracing": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        },
        "authorizationPolicies": {
          "type": [
            "object",
            "null"
          ],
          "propertyNames": {
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
          },
          "additionalProperties": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "action": {
                "type": "string",
                "enum": [
                  "ALLOW",
                  "DENY",
                  "AUDIT",
                  "CUSTOM"
                ]
              },
              "provider": {
                "type": "object"
              },
              "rules": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  }
}
