{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "istio-envoyfilters values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object"
    },
    "nameOverride": {
      "type": ["string", "null"]
    },
    "fullnameOverride": {
      "type": ["string", "null"]
    },
    "defaultNamespace": {
      "type": "string",
      "minLength": 1
    },
    "commonLabels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "commonAnnotations": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "envoyFilters": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
      },
      "additionalProperties": {
        "$ref": "#/definitions/envoyFilter"
      }
    },
    "extraObjects": {
      "type": "array",
      "items": {
        "type": ["object", "string"]
      }
    }
  },
  "definitions": {
    "envoyFilter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "not": {
        "required": ["workloadSelector", "targetRefs"]
      },
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "namespace": {
          "type": "string",
          "minLength": 1
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "priority": {
          "type": "integer"
        },
        "workloadSelector": {
          "type": "object",
          "additionalProperties": false,
          "required": ["labels"],
          "properties": {
            "labels": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        },
        "targetRefs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "name"],
            "properties": {
              "kind": {
                "type": "string"
              },
              "group": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            }
          }
        },
        "configPatches": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["applyTo"],
            "properties": {
              "applyTo": {
                "type": "string"
              },
              "match": {
                "type": "object"
              },
              "patch": {
                "type": "object"
              }
            }
          }
        }
      }
    }
  }
}
