{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "aurora-database-insights-exporter values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object"
    },
    "nameOverride": {
      "type": ["string", "null"]
    },
    "fullnameOverride": {
      "type": ["string", "null"]
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 0
    },
    "revisionHistoryLimit": {
      "type": "integer",
      "minimum": 0
    },
    "podAnnotations": {
      "$ref": "#/definitions/stringMap"
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "registry": {
          "type": "string"
        },
        "repository": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "pullPolicy": {
          "$ref": "#/definitions/pullPolicy"
        }
      }
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "$ref": "#/definitions/stringMap"
        },
        "automountServiceAccountToken": {
          "type": "boolean"
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["ClusterIP", "NodePort", "LoadBalancer"]
        },
        "port": {
          "$ref": "#/definitions/port"
        },
        "trafficDistribution": {
          "type": "string"
        }
      }
    },
    "serviceMonitor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "interval": {
          "type": "string"
        },
        "scrapeTimeout": {
          "type": "string"
        },
        "labels": {
          "$ref": "#/definitions/stringMap"
        },
        "metricRelabelings": {
          "type": "array"
        }
      }
    },
    "prometheusRules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "namespace": {
          "type": "string"
        },
        "labels": {
          "$ref": "#/definitions/stringMap"
        },
        "rules": {
          "type": "array"
        }
      }
    },
    "config": {
      "$ref": "#/definitions/config"
    },
    "resizePolicy": {
      "type": "array"
    },
    "resources": {
      "type": "object"
    },
    "priorityClassName": {
      "type": "string"
    },
    "podSecurityContext": {
      "type": "object"
    },
    "securityContext": {
      "type": "object"
    },
    "pdb": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "maxUnavailable": {
          "type": ["integer", "string"]
        },
        "unhealthyPodEvictionPolicy": {
          "type": ["string", "null"],
          "enum": ["", null, "IfHealthyBudget", "AlwaysAllow"]
        }
      }
    },
    "nodeSelector": {
      "$ref": "#/definitions/stringMap"
    },
    "tolerations": {
      "type": "array"
    },
    "affinity": {
      "type": "object"
    },
    "topologySpreadConstraints": {
      "type": "array"
    },
    "extraObjects": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "definitions": {
    "stringMap": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "stringList": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "pullPolicy": {
      "type": "string",
      "enum": ["Always", "IfNotPresent", "Never"]
    },
    "tagFilter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "value"],
      "properties": {
        "key": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "aws": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "region": {
              "type": "string"
            }
          }
        },
        "discovery": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "intervalSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "engines": {
              "$ref": "#/definitions/stringList"
            },
            "requirePIEnabled": {
              "type": "boolean"
            },
            "exportedTags": {
              "$ref": "#/definitions/stringList"
            },
            "include": {
              "type": ["object", "null"],
              "additionalProperties": false,
              "properties": {
                "identifiers": {
                  "$ref": "#/definitions/stringList"
                },
                "tags": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/tagFilter"
                  }
                }
              }
            },
            "exclude": {
              "type": ["object", "null"],
              "additionalProperties": false,
              "properties": {
                "identifiers": {
                  "$ref": "#/definitions/stringList"
                }
              }
            }
          }
        },
        "collection": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "intervalSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "topSqlLimit": {
              "type": "integer",
              "minimum": 0
            },
            "topHostLimit": {
              "type": "integer",
              "minimum": 0
            },
            "maxConcurrentInstances": {
              "type": "integer",
              "minimum": 1
            },
            "instanceTimeoutSeconds": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    }
  }
}
