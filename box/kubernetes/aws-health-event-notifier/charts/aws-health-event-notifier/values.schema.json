{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "aws-health-event-notifier values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object"
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 0
    },
    "revisionHistoryLimit": {
      "type": "integer",
      "minimum": 0
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "registry": {
          "type": "string"
        },
        "repository": {
          "type": "string"
        },
        "pullPolicy": {
          "$ref": "#/definitions/pullPolicy"
        },
        "tag": {
          "type": "string"
        }
      }
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "nameOverride": {
      "type": ["string", "null"]
    },
    "fullnameOverride": {
      "type": ["string", "null"]
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "$ref": "#/definitions/stringMap"
        },
        "automountServiceAccountToken": {
          "type": "boolean"
        }
      }
    },
    "resources": {
      "type": "object"
    },
    "resizePolicy": {
      "type": "array"
    },
    "securityContext": {
      "type": "object"
    },
    "podSecurityContext": {
      "type": "object"
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["ClusterIP", "NodePort", "LoadBalancer"]
        },
        "adminPort": {
          "$ref": "#/definitions/port"
        },
        "annotations": {
          "$ref": "#/definitions/stringMap"
        },
        "trafficDistribution": {
          "type": "string"
        }
      }
    },
    "poller": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "intervalSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "initialLookbackSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "coldStartSuppress": {
          "type": "boolean"
        },
        "eventLocale": {
          "type": "string"
        },
        "reminderOffsetsHours": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "rbac": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "maxUnavailable": {
          "type": ["integer", "string"]
        },
        "unhealthyPodEvictionPolicy": {
          "type": "string",
          "enum": ["IfHealthyBudget", "AlwaysAllow"]
        }
      }
    },
    "serviceMonitor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "interval": {
          "type": "string"
        },
        "scrapeTimeout": {
          "type": "string"
        },
        "additionalLabels": {
          "$ref": "#/definitions/stringMap"
        }
      }
    },
    "slack": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "webhookUrl": {
          "type": "string"
        },
        "existingSecret": {
          "type": "string"
        },
        "existingSecretKey": {
          "type": "string"
        },
        "channel": {
          "type": "string"
        },
        "username": {
          "type": "string"
        },
        "iconEmoji": {
          "type": "string"
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "logging": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "level": {
          "type": "string"
        },
        "json": {
          "type": "boolean"
        }
      }
    },
    "filter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowCategories": {
          "$ref": "#/definitions/stringList"
        },
        "denyCategories": {
          "$ref": "#/definitions/stringList"
        },
        "allowServices": {
          "$ref": "#/definitions/stringList"
        },
        "denyServices": {
          "$ref": "#/definitions/stringList"
        },
        "allowRegions": {
          "$ref": "#/definitions/stringList"
        },
        "denyRegions": {
          "$ref": "#/definitions/stringList"
        },
        "allowEventCodes": {
          "$ref": "#/definitions/eventCodeList"
        },
        "denyEventCodes": {
          "$ref": "#/definitions/eventCodeList"
        }
      }
    },
    "extraEnv": {
      "type": "object"
    },
    "nodeSelector": {
      "$ref": "#/definitions/stringMap"
    },
    "tolerations": {
      "type": "array"
    },
    "affinity": {
      "type": "object"
    },
    "topologySpreadConstraints": {
      "type": "array"
    },
    "extraObjects": {
      "type": "array",
      "items": {
        "type": ["object", "string"]
      }
    }
  },
  "definitions": {
    "stringMap": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "stringList": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "eventCodeList": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[^/]+/.+$"
      }
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "pullPolicy": {
      "type": "string",
      "enum": ["Always", "IfNotPresent", "Never"]
    }
  }
}
