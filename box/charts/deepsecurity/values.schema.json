{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "deepsecurity values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object"
    },
    "enabled": {
      "type": "boolean"
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "tag"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": [
            "string",
            "integer"
          ],
          "minLength": 1
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "dsm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "managerUrl",
        "activationUrl",
        "policyId"
      ],
      "properties": {
        "managerUrl": {
          "type": "string",
          "pattern": "^https://"
        },
        "activationUrl": {
          "type": "string",
          "pattern": "^dsm://"
        },
        "policyId": {
          "type": [
            "string",
            "integer"
          ],
          "pattern": "^[0-9]+$",
          "minimum": 1
        },
        "agentVersion": {
          "type": "string"
        }
      }
    },
    "namespace": {
      "type": "string",
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "dnsConfig": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "affinity": {
      "type": "object"
    }
  }
}
